# Environment Variables Template for Integrated Retail
# Duplicate this file to .env.local for local development or .env.production for production

# WordPress API Origin
WP_API_ORIGIN=https://integratedretail.com

# Resend Email Delivery
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL="Integrated Retail <website@integratedretail.com>"
CONTACT_RECIPIENT=connect@integratedretail.com

# Gravity Forms REST API
GF_FORM_ID=1
GF_CONSUMER_KEY=your_gravity_forms_consumer_key_here
GF_CONSUMER_SECRET=your_gravity_forms_consumer_secret_here
