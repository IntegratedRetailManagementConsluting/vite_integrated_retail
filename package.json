{
  "name": "integratedretail-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:partials": "python3 build_site.py",
    "dev": "python3 build_site.py && vite",
    "build": "python3 build_site.py && vite build",
    "preview": "vite preview",
    "deploy": "python3 build_site.py && vite build && wrangler pages deploy dist --project-name=integratedretail-site --branch=main"
  },
  "dependencies": {
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "wrangler": "^4.153.0"
  }
}
